diff --git a/Common/Profiler/WebOSPerf.h b/Common/Profiler/WebOSPerf.h
new file mode 100644
index 0000000..8eec197
--- /dev/null
+++ b/Common/Profiler/WebOSPerf.h
@@ -0,0 +1,41 @@
+// Community webOS modifications, 2026-10-31; see MODIFICATIONS.md.
+#pragma once
+
+// Opt-in wall-clock checkpoints for the webOS port. No timing or I/O when off.
+#include <cstdint>
+#if defined(__linux__) && defined(__aarch64__)
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include "Common/TimeUtil.h"
+#endif
+
+class WebOSPerfSpan {
+public:
+	explicit WebOSPerfSpan(const char *stage) : stage_(stage) {
+#if defined(__linux__) && defined(__aarch64__)
+		static const bool enabled = [] {
+			const char *p = std::getenv("PPSSPP_BRIDGE_PROFILE");
+			return p && std::strcmp(p, "1") == 0;
+		}();
+		if (enabled) start_ = time_now_raw();
+#endif
+	}
+	~WebOSPerfSpan() { Checkpoint(stage_); }
+	void Checkpoint(const char *stage) {
+#if defined(__linux__) && defined(__aarch64__)
+		if (!start_) return;
+		const uint64_t end = time_now_raw();
+		if (end - start_ > 50000000ULL)
+			std::fprintf(stderr, "[perf-span] {\"stage\":\"%s\",\"start_ns\":%llu,\"end_ns\":%llu,\"ns\":%llu,\"tid\":%ld}\n",
+				stage, (unsigned long long)start_, (unsigned long long)end,
+				(unsigned long long)(end - start_), syscall(SYS_gettid));
+		start_ = end;
+#endif
+	}
+private:
+	const char *stage_;
+	uint64_t start_ = 0;
+};
