+bool WebOSPrepareBridge() {
+    // Keep one emulator per application; the proxy must not inherit this lock.
+    static int instanceLock = open("/media/developer/ppsspp-webos-data/run.lock",
+        O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+    if (instanceLock < 0 || flock(instanceLock, LOCK_EX | LOCK_NB) < 0) {
+        std::fprintf(stderr, "[webos] another PPSSPP instance already owns the application lock\n");
+        return false;
+    }
+    const char *path = "/media/developer/ppsspp-webos-data/last-pid";
+    long previous = 0;
+    if (FILE *file = std::fopen(path, "r")) {
+        if (std::fscanf(file, "%ld", &previous) != 1) previous = 0;
+        std::fclose(file);
+    }
+    // Never touch active segments or segments created by a different application run.
+    if (previous > 0 && kill((pid_t)previous, 0) < 0 && errno == ESRCH) {
+        const key_t base = (key_t)(0x50500000u + (uint32_t)previous * 8u);
+        for (key_t key = base + 1; key <= base + 4; ++key) {
+            int id = shmget(key, 0, 0600);
+            shmid_ds info{};
+            if (id >= 0 && shmctl(id, IPC_STAT, &info) == 0 &&
+                info.shm_cpid == previous && info.shm_nattch == 0 &&
+                info.shm_perm.uid == geteuid()) {
+                shmctl(id, IPC_RMID, nullptr);
+            }
+        }
+    }
+    char baseText[32];
+    const uint32_t base = 0x50500000u + (uint32_t)getpid() * 8u;
+    std::snprintf(baseText, sizeof(baseText), "0x%x", base);
+    setenv("PPSSPP_BRIDGE_SHM_BASE", baseText, 1);
+    std::fprintf(stderr, "[webos] private Bridge IPC base=%s\n", baseText);
+    if (FILE *file = std::fopen(path, "w")) {
+        std::fprintf(file, "%ld\n", (long)getpid());
+        std::fclose(file);
+    }
+    return true;
+}
+
+void WebOSMountUSB() {
+    // Native devmode jails do not include removable-device mounts on this TV.
+    // Use the already-installed Homebrew root service for our fixed helper;
+    // its only operation is a read-only bind into this app's own jail.
+    const pid_t child = fork();
+    if (child == 0) {
+        const int log = open("/media/developer/ppsspp-webos-data/usb-mount.log",
+            O_CREAT | O_TRUNC | O_WRONLY, 0644);
+        if (log >= 0) { dup2(log, STDOUT_FILENO); dup2(log, STDERR_FILENO); close(log); }
+        execl("/usr/bin/timeout", "timeout", "8", "/usr/bin/luna-send-pub",
+            "-n", "1",
+            "luna://org.webosbrew.hbchannel.service/exec",
+            "{\"command\":\"/media/developer/apps/usr/palm/applications/org.ppsspp.webos/service/usb-mount-helper\"}",
+            (char *)nullptr);
+        _exit(127);
+    }
+    if (child > 0) {
+        int status;
+        while (waitpid(child, &status, 0) < 0 && errno == EINTR) {}
+    }
+}
+
+namespace {
+std::atomic<uint64_t> g_lastGameplayNs{0};
+int g_screenSaverPipe = -1;
+pid_t g_screenSaverPid = -1;
+}
+
+void WebOSScreenSaverActivity() {
+    g_lastGameplayNs.store(time_now_raw(), std::memory_order_relaxed);
+}
+
+void WebOSScreenSaverStart() {
+    int fds[2];
+    if (pipe2(fds, O_CLOEXEC) < 0) return;
+    const pid_t parent = getpid();
+    const pid_t child = fork();
+    if (child == 0) {
+        prctl(PR_SET_PDEATHSIG, SIGTERM);
+        if (getppid() != parent) _exit(1);
+        dup2(fds[0], STDIN_FILENO);
+        close(fds[0]); close(fds[1]);
+        const int log = open("/media/developer/ppsspp-webos-data/screensaver.log",
+            O_CREAT | O_TRUNC | O_WRONLY, 0644);
+        if (log >= 0) { dup2(log, STDOUT_FILENO); dup2(log, STDERR_FILENO); close(log); }
+        execl("/media/developer/apps/usr/palm/applications/org.ppsspp.webos/service/screensaver-guard",
+            "screensaver-guard", (char *)nullptr);
+        _exit(127);
+    }
+    close(fds[0]);
+    if (child < 0) { close(fds[1]); return; }
+    g_screenSaverPipe = fds[1]; g_screenSaverPid = child;
+    fcntl(g_screenSaverPipe, F_SETFL, fcntl(g_screenSaverPipe, F_GETFL) | O_NONBLOCK);
+    std::atexit(WebOSScreenSaverStop);
+}
+
+void WebOSScreenSaverPulse() {
+    static uint64_t last = 0;
+    if (g_screenSaverPipe < 0) return;
+    const uint64_t now = time_now_raw();
+    if (now - last < 1000000000ULL) return;
+    last = now;
+    const uint64_t gameplay = g_lastGameplayNs.load(std::memory_order_relaxed);
+    const char value = gameplay && now - gameplay < 1500000000ULL ? '1' : '0';
+    if (write(g_screenSaverPipe, &value, 1) < 0 && errno == EPIPE) {
+        close(g_screenSaverPipe); g_screenSaverPipe = -1;
+    }
+}
+
+void WebOSScreenSaverStop() {
+    if (g_screenSaverPipe >= 0) { close(g_screenSaverPipe); g_screenSaverPipe = -1; }
+    if (g_screenSaverPid > 0) {
+        // Bridge's SIGCHLD handler may already have reaped this child.
+        // Never signal a stale PID after it has stopped being our child.
+        const pid_t child = g_screenSaverPid;
+        g_screenSaverPid = -1;
+        if (waitpid(child, nullptr, WNOHANG) == 0) {
+            kill(child, SIGTERM);
+            while (waitpid(child, nullptr, 0) < 0 && errno == EINTR) {}
+        }
+    }
+}
+
+void WebOSNotifyAppExit() {
+    WebOSScreenSaverStop();
+    if (auto shutdownBridge = (void (*)())dlsym(RTLD_DEFAULT, "ppsspp_bridge_shutdown")) {
+        shutdownBridge();
+    }
+    // Let SAM know this is an intentional exit rather than an unexpected death.
+    const pid_t child = fork();
+    if (child == 0) {
+        execl("/usr/bin/luna-send-pub", "luna-send-pub", "-n", "1",
+            "luna://com.webos.applicationManager/closeByAppId",
+            "{\"id\":\"org.ppsspp.webos\"}", (char *)nullptr);
+        _exit(127);
+    }
+    if (child > 0) {
+        for (int i = 0; i < 20; ++i) {
+            if (waitpid(child, nullptr, WNOHANG) != 0) return;
+            usleep(100000);
+        }
+        kill(child, SIGTERM);
+        waitpid(child, nullptr, 0);
+    }
+}
+
+bool WebOSAttachWindow(SDL_Window *window) {
+    if (!window) {
+        std::fprintf(stderr, "[webos] cannot attach a null SDL window\n");
+        return false;
+    }
+    const auto existing = std::find_if(g_attachedWindows.begin(), g_attachedWindows.end(),
+        [window](const WindowState &state) { return state.window == window; });
+    if (existing != g_attachedWindows.end()) {
+        return true;
+    }
+
+    const SDL_PropertiesID properties = SDL_GetWindowProperties(window);
+    auto *display = static_cast<wl_display *>(SDL_GetPointerProperty(
+        properties, SDL_PROP_WINDOW_WAYLAND_DISPLAY_POINTER, nullptr));
+    auto *surface = static_cast<wl_surface *>(SDL_GetPointerProperty(
+        properties, SDL_PROP_WINDOW_WAYLAND_SURFACE_POINTER, nullptr));
+    if (!display || !surface) {
+        std::fprintf(stderr, "[webos] SDL window has no Wayland display/surface\n");
+        return false;
+    }
+
+    WindowState state;
+    state.window = window;
+    state.display = display;
+    state.registry = wl_display_get_registry(display);
+    if (!state.registry || wl_registry_add_listener(state.registry, &kRegistryListener, &state) < 0 ||
+        RoundtripFailed(display)) {
+        DestroyState(state);
+        return false;
+    }
+    if (!state.shell || !state.webosShell) {
+        std::fprintf(stderr, "[webos] compositor is missing wl_shell or wl_webos_shell\n");
+        DestroyState(state);
+        return false;
+    }
+
+    state.shellSurface = wl_shell_get_shell_surface(state.shell, surface);
+    if (!state.shellSurface) {
+        std::fprintf(stderr, "[webos] failed to create wl_shell_surface\n");
+        DestroyState(state);
+        return false;
+    }
+    wl_shell_surface_set_toplevel(state.shellSurface);
+
+    state.webosShellSurface = wl_webos_shell_get_shell_surface(state.webosShell, surface);
+    if (!state.webosShellSurface) {
+        std::fprintf(stderr, "[webos] failed to create wl_webos_shell_surface\n");
+        DestroyState(state);
+        return false;
+    }
+    wl_webos_shell_surface_set_property(state.webosShellSurface, "appId", "org.ppsspp.webos");
+    wl_webos_shell_surface_set_property(state.webosShellSurface, "title", "PPSSPP");
+    wl_webos_shell_surface_set_property(state.webosShellSurface, "displayAffinity", "0");
+    wl_webos_shell_surface_set_property(state.webosShellSurface,
+        "_WEBOS_ACCESS_POLICY_KEYS_BACK", "true");
+
+    if (wl_display_flush(display) < 0 && errno != EAGAIN && errno != EINTR) {
+        std::fprintf(stderr, "[webos] failed to flush shell-surface requests\n");
+        DestroyState(state);
+        return false;
+    }
+    g_attachedWindows.push_back(state);
+    std::fprintf(stderr, "[webos] attached PPSSPP window to webOS shell\n");
+    return true;
+}
+
+void WebOSDetachWindow(SDL_Window *window) {
+    const auto attached = std::find_if(g_attachedWindows.begin(), g_attachedWindows.end(),
+        [window](const WindowState &state) { return state.window == window; });
+    if (attached == g_attachedWindows.end()) {
+        return;
+    }
+    DestroyState(*attached);
+    g_attachedWindows.erase(attached);
+    std::fprintf(stderr, "[webos] detached PPSSPP window from webOS shell\n");
+}
