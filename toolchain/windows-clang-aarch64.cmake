set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SKIP_BUILD_RPATH ON)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
get_filename_component(PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(SDK "${CMAKE_CURRENT_LIST_DIR}/aarch64-webos-linux-gnu_sdk-buildroot")
set(CMAKE_SYSROOT "${SDK}/aarch64-webos-linux-gnu/sysroot")
set(CMAKE_C_COMPILER "C:/Program Files/LLVM/bin/clang.exe")
set(CMAKE_CXX_COMPILER "C:/Program Files/LLVM/bin/clang++.exe")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_COMPILER_TARGET aarch64-webos-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-webos-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET aarch64-webos-linux-gnu)
set(CMAKE_C_FLAGS_INIT "--gcc-toolchain=${SDK} -fuse-ld=lld -mcpu=cortex-a78")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_ASM_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_AR "C:/Program Files/LLVM/bin/llvm-ar.exe")
set(CMAKE_RANLIB "C:/Program Files/LLVM/bin/llvm-ranlib.exe")
set(CMAKE_FIND_ROOT_PATH "${PROJECT_ROOT}/stage;${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_INSTALL_PREFIX "${PROJECT_ROOT}/stage" CACHE PATH "")
set(BRIDGE "/media/developer/apps/usr/palm/applications/org.webosbrew.bridge-64to32")
set(APP "/media/developer/apps/usr/palm/applications/org.ppsspp.webos")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,--dynamic-linker,${BRIDGE}/lib/ld-linux-aarch64.so.1 -Wl,--disable-new-dtags,-rpath,${APP}/lib:${BRIDGE}/lib:${BRIDGE}/lib/pulseaudio")
