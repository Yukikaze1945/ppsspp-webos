set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SKIP_BUILD_RPATH ON)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

get_filename_component(PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(SDK "${CMAKE_CURRENT_LIST_DIR}/aarch64-webos-linux-gnu_sdk-buildroot")
set(CMAKE_SYSROOT "${SDK}/aarch64-webos-linux-gnu/sysroot")
set(TOOL_PREFIX "${SDK}/bin/aarch64-webos-linux-gnu-")

set(CMAKE_C_COMPILER "${TOOL_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${TOOL_PREFIX}g++")
set(CMAKE_ASM_COMPILER "${TOOL_PREFIX}gcc")
set(CMAKE_AR "${TOOL_PREFIX}ar")
set(CMAKE_RANLIB "${TOOL_PREFIX}ranlib")
set(CMAKE_STRIP "${TOOL_PREFIX}strip")
set(CMAKE_NM "${TOOL_PREFIX}nm")
set(CMAKE_OBJCOPY "${TOOL_PREFIX}objcopy")
set(CMAKE_OBJDUMP "${TOOL_PREFIX}objdump")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a78")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a78")
set(CMAKE_ASM_FLAGS_INIT "-mcpu=cortex-a78")

set(BRIDGE "/media/developer/apps/usr/palm/applications/org.webosbrew.bridge-64to32")
set(APP "/media/developer/apps/usr/palm/applications/org.ppsspp.webos")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,--dynamic-linker,${BRIDGE}/lib/ld-linux-aarch64.so.1 -Wl,--disable-new-dtags,-rpath,${APP}/lib:${BRIDGE}/lib:${BRIDGE}/lib/pulseaudio")

set(CMAKE_FIND_ROOT_PATH "${PROJECT_ROOT}/stage;${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_INSTALL_PREFIX "${PROJECT_ROOT}/stage" CACHE PATH "")
